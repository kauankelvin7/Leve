{
  "name": "leve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "migrate:notification-tokens": "node scripts/migrations/001-separate-notification-tokens.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && npm run check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "npm audit --omit=dev --audit-level=moderate && npm run lint && npm run build && npm test && npm run test:integration && npm run test:e2e:critical",
    "test:integration": "firebase emulators:exec --project demo-leve --only auth,firestore \"npm run test:integration:inside\"",
    "test:integration:inside": "vitest run --config vitest.integration.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e:critical": "npm run test:e2e:local -- gika-create.spec.ts gika-reschedule.spec.ts gika-recurrence.spec.ts gika-batch.spec.ts gika-organization.spec.ts --grep \"M3-T2 double submit|logout during upstream wait|M5-T2 failure before commit|M5-T2 tampered transport target or patch|M5-T3 tampered scope transport|M5-T4 second lost ack|M5-T4 explicitly scoped occurrence|M6 week uses\"",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "gika:smoke": "node scripts/gika-smoke.mjs"
  },
  "dependencies": {
    "@dicebear/avataaars": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/nunito": "^5.2.7",
    "@js-temporal/polyfill": "0.5.1",
    "@rive-app/canvas": "2.44.0",
    "express": "5.2.1",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "three": "^0.186.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.35.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "firebase-tools": "15.30.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@firebase/firestore@4.17.2": {
      "@grpc/grpc-js": "1.14.5"
    },
    "google-gax@4.6.1": {
      "@grpc/grpc-js": "1.14.5",
      "uuid": "11.1.1"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "teeny-request@9.0.0": {
      "uuid": "11.1.1"
    }
  }
}
