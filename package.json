{
  "name": "leve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "migrate:notification-tokens": "node scripts/migrations/001-separate-notification-tokens.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:integration": "firebase emulators:exec --project demo-leve --only auth,firestore \"npm run test:integration:inside\"",
    "test:integration:inside": "vitest run --config vitest.integration.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/nunito": "^5.2.7",
    "@js-temporal/polyfill": "0.5.1",
    "express": "5.2.1",
    "firebase": "12.19.0",
    "firebase-admin": "13.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "three": "^0.186.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "firebase-tools": "15.30.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
